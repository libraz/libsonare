{
  "_": "The joint excitation-and-decay fit of electric_guitar_joint.json with the register balance put into the objective: every metric term is h1-normalised, so a fit left alone darkened the top of the compass by 4-11 dB against the bottom through cutoff_hz and nothing charged it. `level` scores the spread of per-note level around the grid's offset, which is that balance. decay_s is opened to 30 s because the unweighted fit pinned at the 20 s end.",
  "weights": {
    "level": 1.0
  },
  "knobs": [
    {
      "tunable": "clean_guitar.ks.decay_s",
      "min": 1.0,
      "max": 30.0,
      "scale": "log"
    },
    {
      "tunable": "clean_guitar.ks.mid_decay_s",
      "min": 0.0,
      "max": 2.0,
      "scale": "linear"
    },
    {
      "tunable": "clean_guitar.ks.decay_stretch",
      "min": 0.0,
      "max": 1.0,
      "scale": "linear"
    },
    {
      "tunable": "clean_guitar.ks.exc_brightness",
      "min": 0.0,
      "max": 1.0,
      "scale": "linear"
    },
    {
      "tunable": "clean_guitar.cutoff_hz",
      "min": 800.0,
      "max": 22000.0,
      "scale": "log"
    },
    {
      "tunable": "clean_guitar.ks.vel_to_brightness",
      "min": 0.0,
      "max": 1.0,
      "scale": "linear"
    },
    {
      "tunable": "clean_guitar.ks.pick_position",
      "min": 0.0,
      "max": 0.5,
      "scale": "linear"
    },
    {
      "tunable": "clean_guitar.ks.body_coupling",
      "min": 0.0,
      "max": 1.0,
      "scale": "linear"
    },
    {
      "tunable": "clean_guitar.ks.pick_noise",
      "min": 0.0,
      "max": 1.0,
      "scale": "linear"
    }
  ]
}
