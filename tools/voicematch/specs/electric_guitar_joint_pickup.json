{
  "_": "The joint excitation-and-decay fit with register balance weighted, plus the two fields that shape the partial stack from the output side: resonance_q, the resonant peak a magnetic pickup's inductance makes against the cable's capacitance at the filter corner, and ks.pickup_pos, the pickup's own position comb. Without them the fit reached the reference's steep roll-off only by lowering cutoff_hz to 906 Hz, which darkened h2-h6 against h1 by 17 dB.",
  "weights": {
    "level": 1.0
  },
  "knobs": [
    {
      "tunable": "clean_guitar.ks.decay_s",
      "min": 1.0,
      "max": 30.0,
      "scale": "log"
    },
    {
      "tunable": "clean_guitar.ks.mid_decay_s",
