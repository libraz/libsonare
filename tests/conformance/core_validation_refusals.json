      { "id": "rate_tiny", "sample_rate": 100, "max_block_size": 512, "cause": "argument", "message": "sample_rate must be finite and within [8000, 384000]" },
      { "id": "rate_above_max", "sample_rate": 384001, "max_block_size": 512, "cause": "argument", "message": "sample_rate must be finite and within [8000, 384000]" },
