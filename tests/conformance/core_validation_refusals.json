    "refused": [
      { "id": "zero_iter", "n_iter": 0, "cause": "argument", "message": "n_iter must be >= 1" },
      { "id": "negative_iter", "n_iter": -1, "cause": "argument", "message": "n_iter must be >= 1" }
    ]
  },
