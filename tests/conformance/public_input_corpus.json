  "scene_insert_refusal": {
    "fn": "Mixer.from_json",
    "options": {"sample_rate": 48000, "max_block_size": 256},
    "scene": {"version": 2, "strips": [{"id": "s", "inserts": [{"slot": "post", "processor": "eq.parametric", "params": {}}]}], "buses": [{"id": "master", "role": "master"}], "connections": []},
    "cases": [
      { "id": "band0_frequency_accepted", "param": "band0.frequencyHz", "value": 1000, "accepted": true },
      { "id": "band0_frequency_zero", "param": "band0.frequencyHz", "value": 0, "code_name": "InvalidFormat", "message": "strips[0].inserts[0].params.band0.frequencyHz must be finite and in (0, 24000)" },
      { "id": "band0_frequency_at_nyquist", "param": "band0.frequencyHz", "value": 24000, "code_name": "InvalidFormat", "message": "strips[0].inserts[0].params.band0.frequencyHz must be finite and in (0, 24000)" },
      { "id": "band0_frequency_null", "param": "band0.frequencyHz", "value": null, "code_name": "InvalidFormat", "message": "strips[0].inserts[0].params.band0.frequencyHz must be a number or a boolean" },
      { "id": "band0_q_zero", "param": "band0.q", "value": 0, "code_name": "InvalidFormat", "message": "strips[0].inserts[0].params.band0.q must be finite and greater than 0" }
