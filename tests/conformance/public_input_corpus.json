      { "id": "group_above_domain", "key": "group", "value": 16, "refused": "range", "predicate": "must be an integer in [0, 15]" },
      { "id": "channel_fraction", "key": "channel", "value": 0.5, "refused": "range", "predicate": "must be an integer in [0, 15]" },
      { "id": "channel_above_domain", "key": "channel", "value": 16, "refused": "range", "predicate": "must be an integer in [0, 15]" },
