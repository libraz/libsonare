  },
  "constraints": [
    "IF surface = python THEN call_form IN {keyword, positional}",
    "IF surface IN {wasm, node} THEN call_form IN {request, positional}",
    "IF surface IN {wasm, node} AND call_form = positional THEN value_class != omitted"
  ],
  "strength": 2,
  "seed": 20261117,
