{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libsonare.local/schemas/realtime-voice-changer-preset.schema.json",
  "title": "Realtime Voice Changer Preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category"],
  "oneOf": [{"required": ["dsp"]}, {"required": ["macros"]}],
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion", "dsp"]},
      "then": {
        "properties": {
          "dsp": {
            "required": ["voiceEngine", "pitchCorrection", "harmony", "vocoder", "character", "reverbVariation", "midi"]
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Preset schema version. 2 is current and requires the voice transformer sections of dsp (voiceEngine, pitchCorrection, harmony, vocoder, character, reverbVariation, midi). 1 predates them: a version 1 document omits them and loads with their defaults. Writers emit 2."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 96
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "description": { "type": "string", "maxLength": 512 },
    "category": {
      "type": "string",
      "enum": ["monitor", "bright", "soft", "deep", "robot", "dark", "tune", "harmony", "vocoder", "character", "custom"]
    },
    "macros": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pitch": { "type": "number", "minimum": -24.0, "maximum": 24.0 },
        "formant": { "type": "number", "minimum": 0.55, "maximum": 1.65 },
        "brightness": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "space": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "intensity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "noiseControl": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "sibilance": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "dsp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retune", "formant", "eq", "gate", "compressor", "deesser", "reverb", "limiter"],
      "properties": {
        "inputGainDb": { "type": "number", "minimum": -24.0, "maximum": 24.0 },
        "outputGainDb": { "type": "number", "minimum": -36.0, "maximum": 12.0 },
        "wetMix": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "retune": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semitones", "mix", "grainSize"],
          "properties": {
            "semitones": { "type": "number", "minimum": -24.0, "maximum": 24.0 },
            "mix": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "grainSize": { "type": "integer", "minimum": 0, "maximum": 8192 }
          }
        },
        "formant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["factor", "amount", "body", "brightness", "nasal"],
          "properties": {
            "factor": { "type": "number", "minimum": 0.55, "maximum": 1.65 },
            "amount": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "body": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
            "brightness": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
            "nasal": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
            "mode": {
              "type": "string",
              "enum": ["relative", "absolute"],
              "default": "relative",
              "description": "absolute warps the formants to factor times the input's ahead of the retune (amount is ignored, one analysis frame of latency is added); fixed when the changer is prepared."
            }
          }
        },
        "eq": {
          "type": "object",
          "additionalProperties": false,
          "required": ["highpassHz", "bodyDb", "presenceDb", "airDb"],
          "properties": {
            "highpassHz": { "type": "number", "minimum": 20.0, "maximum": 300.0 },
            "bodyDb": { "type": "number", "minimum": -12.0, "maximum": 12.0 },
            "presenceDb": { "type": "number", "minimum": -12.0, "maximum": 12.0 },
            "airDb": { "type": "number", "minimum": -12.0, "maximum": 12.0 }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thresholdDb", "attackMs", "releaseMs", "rangeDb"],
          "properties": {
            "thresholdDb": { "type": "number", "minimum": -90.0, "maximum": -12.0 },
            "attackMs": { "type": "number", "minimum": 0.05, "maximum": 100.0 },
            "releaseMs": { "type": "number", "minimum": 5.0, "maximum": 1000.0 },
            "rangeDb": { "type": "number", "minimum": 0.0, "maximum": 80.0 }
          }
        },
        "compressor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thresholdDb", "ratio", "attackMs", "releaseMs", "makeupGainDb"],
          "properties": {
            "thresholdDb": { "type": "number", "minimum": -60.0, "maximum": 0.0 },
            "ratio": { "type": "number", "minimum": 1.0, "maximum": 20.0 },
            "attackMs": { "type": "number", "minimum": 0.05, "maximum": 200.0 },
            "releaseMs": { "type": "number", "minimum": 5.0, "maximum": 2000.0 },
            "makeupGainDb": { "type": "number", "minimum": -12.0, "maximum": 12.0 }
          }
        },
        "deesser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frequencyHz", "thresholdDb", "ratio", "rangeDb"],
          "properties": {
            "frequencyHz": { "type": "number", "minimum": 3000.0, "maximum": 12000.0 },
            "thresholdDb": { "type": "number", "minimum": -60.0, "maximum": -6.0 },
            "ratio": { "type": "number", "minimum": 1.0, "maximum": 20.0 },
            "rangeDb": { "type": "number", "minimum": 0.0, "maximum": 24.0 }
          }
        },
        "reverb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mix", "timeMs", "damping", "seed"],
          "properties": {
            "mix": { "type": "number", "minimum": 0.0, "maximum": 0.45 },
            "timeMs": { "type": "number", "minimum": 40.0, "maximum": 1800.0 },
            "damping": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "seed": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
          }
        },
        "limiter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ceilingDb", "releaseMs"],
          "properties": {
            "ceilingDb": { "type": "number", "minimum": -12.0, "maximum": -1.0 },
            "releaseMs": { "type": "number", "minimum": 1.0, "maximum": 500.0 },
            "enableIspLimiter": { "type": "boolean" },
            "ispCeilingDbtp": { "type": "number", "minimum": -12.0, "maximum": 0.0 }
          }
        },
        "voiceEngine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "f0MinHz"],
          "description": "Both fields are fixed when the changer is prepared. grain has no f0, so it refuses pitch correction, harmony and the vocoder.",
          "properties": {
            "engine": { "type": "string", "enum": ["grain", "psola"] },
            "f0MinHz": { "type": "number", "minimum": 50.0, "maximum": 200.0 }
          }
        },
        "pitchCorrection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "amount", "speedMs", "keyRoot", "scale", "robotOctave"],
          "properties": {
            "mode": { "type": "string", "enum": ["off", "auto", "robot"] },
            "amount": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "speedMs": { "type": "number", "minimum": 0.0, "maximum": 400.0 },
            "keyRoot": { "type": "integer", "minimum": 0, "maximum": 11 },
            "scale": { "type": "string", "enum": ["major", "natural_minor", "chromatic"] },
            "robotOctave": { "type": "integer", "minimum": -1, "maximum": 1 }
          }
        },
        "harmony": {
          "type": "object",
          "additionalProperties": false,
          "required": ["voices", "steps", "level", "leadLevel", "detuneCents", "delayMs"],
          "properties": {
            "voices": { "type": "integer", "minimum": 0, "maximum": 3 },
            "steps": {
              "type": "array",
              "maxItems": 3,
              "items": { "type": "integer", "minimum": -7, "maximum": 7 },
              "description": "Scale degrees of the harmony voices from the lead (0 = unison, 2 = a third up); at least one entry per voice."
            },
            "level": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "leadLevel": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "detuneCents": { "type": "number", "minimum": 0.0, "maximum": 30.0 },
            "delayMs": { "type": "number", "minimum": 0.0, "maximum": 40.0 }
          }
        },
        "vocoder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "bands", "attackMs", "releaseMs", "sibilance", "carrierSource", "carrierWave", "ensembleDetuneCents", "level"],
          "properties": {
            "enabled": { "type": "boolean" },
            "bands": { "type": "integer", "minimum": 8, "maximum": 32, "description": "Fixed when the changer is prepared." },
            "attackMs": { "type": "number", "minimum": 0.5, "maximum": 50.0 },
            "releaseMs": { "type": "number", "minimum": 2.0, "maximum": 300.0 },
            "sibilance": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "carrierSource": { "type": "string", "enum": ["internal", "external"] },
            "carrierWave": { "type": "string", "enum": ["saw", "pulse", "ensemble"] },
            "ensembleDetuneCents": { "type": "number", "minimum": 0.0, "maximum": 30.0 },
            "level": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "character": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "amount", "tone"],
          "properties": {
            "type": { "type": "string", "enum": ["none", "megaphone", "radio", "bbd_chorus", "strobo"] },
            "amount": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "tone": { "type": "number", "minimum": -1.0, "maximum": 1.0 }
          }
        },
        "reverbVariation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["variation", "delayMs", "feedback", "tempoBpm", "division"],
          "description": "Every variation mixes at reverb.mix. A computed delay (tempo_delay: 60000 / tempoBpm times the note value) beyond 3000 ms is refused.",
          "properties": {
            "variation": { "type": "string", "enum": ["reverb", "echo", "tempo_delay", "dub_echo"] },
            "delayMs": { "type": "number", "minimum": 1.0, "maximum": 3000.0 },
            "feedback": { "type": "number", "minimum": 0.0, "maximum": 0.95 },
            "tempoBpm": { "type": "number", "minimum": 30.0, "maximum": 300.0 },
            "division": { "type": "string", "enum": ["quarter", "eighth", "dotted_eighth", "sixteenth"] }
          }
        },
        "midi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release"],
          "properties": {
            "release": { "type": "string", "enum": ["hold", "input"] }
          }
        }
      }
    }
  }
}
